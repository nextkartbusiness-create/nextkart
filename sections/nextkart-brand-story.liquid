{{ 'nextkart-homepage.css' | asset_url | stylesheet_tag }}<section class="color-{{ section.settings.color_scheme }} gradient" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="page-width"><div class="nextkart-story__header"><p class="nextkart-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="nextkart-story__title">{{ section.settings.title | escape }}</h2><div class="nextkart-story__description rte">{{ section.settings.description }}</div></div><div class="nextkart-story__grid">{% for block in section.blocks %}<article class="nextkart-story__point" {{ block.shopify_attributes }}><span class="nextkart-story__number">{{ block.settings.number | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"NextKart brand story","tag":"section","class":"section","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY NEXTKART"},{"type":"text","id":"title","label":"Heading","default":"A little more you, every day."},{"type":"richtext","id":"description","label":"Description","default":"<p>We bring together versatile fashion and everyday essentials to make getting dressed feel effortless.</p>"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"background-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":64},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":64}],"blocks":[{"type":"point","name":"Brand value","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"title","label":"Title","default":"Everyday confidence"},{"type":"text","id":"text","label":"Description","default":"Comfort-led styles that feel as good as they look."}]}],"presets":[{"name":"NextKart brand story","blocks":[{"type":"point"},{"type":"point","settings":{"number":"02","title":"For every wardrobe","text":"Discover considered picks across men, women and kids."}},{"type":"point","settings":{"number":"03","title":"A simpler choice","text":"Find new favourites without overthinking your style."}}]}]}
{% endschema %}