{% style %}
  .site-header {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    position: {% if section.settings.sticky_header %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-header__logo-link,
  .site-header__shop-name {
    color: inherit;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
  }

  .site-header__logo-img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .site-header__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .site-header__menu-item {
    position: relative;
  }

  .site-header__menu-link {
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 6px 0;
    display: inline-block;
  }

  .site-header__menu-link:hover,
  .site-header__menu-link.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Dropdown Menu */
  .site-header__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 190px;
    background: {{ section.settings.bg_color }};
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    padding: 8px 0;
    list-style: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .site-header__menu-item:hover .site-header__dropdown {
    display: block;
  }

  .site-header__dropdown-link {
    display: block;
    padding: 8px 16px;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-header__dropdown-link:hover {
    background-color: rgba(0, 0, 0, 0.04);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-header__action-link {
    color: inherit;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-header__mobile-btn {
    display: none;
    background: none;
    border: 1px solid currentColor;
    color: inherit;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 1.1rem;
    cursor: pointer;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .site-header__mobile-btn {
      display: inline-block;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: {{ section.settings.bg_color }};
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      padding: 16px 20px;
    }

    .site-header__nav.is-open {
      display: block;
    }

    .site-header__menu {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .site-header__dropdown {
      position: static;
      box-shadow: none;
      border: none;
      padding-left: 14px;
      display: block;
    }
  }
{% endstyle %}

<header class="site-header">
  <div class="site-header__inner">
    <!-- Brand Logo / Shop Name -->
    <div class="site-header__brand">
      {% if section.settings.logo != blank %}
        <a href="{{ routes.root_url }}" class="site-header__logo-link">
          {{
            section.settings.logo
            | image_url: width: section.settings.logo_width
            | image_tag: alt: shop.name, class: 'site-header__logo-img', loading: 'eager'
          }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="site-header__shop-name">
          {{ shop.name }}
        </a>
      {% endif %}
    </div>

    <!-- Navigation Menu -->
    <nav class="site-header__nav" id="SiteHeaderNav-{{ section.id }}" aria-label="Main Navigation">
      <ul class="site-header__menu">
        {% for link in linklists[section.settings.menu].links %}
          <li class="site-header__menu-item">
            <a
              href="{{ link.url }}"
              class="site-header__menu-link {% if link.active %}is-active{% endif %}"
            >
              {{ link.title }}
            </a>

            {% if link.links != blank %}
              <ul class="site-header__dropdown">
                {% for child_link in link.links %}
                  <li>
                    <a
                      href="{{ child_link.url }}"
                      class="site-header__dropdown-link {% if child_link.active %}is-active{% endif %}"
                    >
                      {{ child_link.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- Right Action Icons -->
    <div class="site-header__actions">
      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="site-header__action-link" aria-label="Search">
          Search
        </a>
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="site-header__action-link" aria-label="Account">
          Account
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="site-header__action-link" aria-label="Cart">
        Cart ({{ cart.item_count }})
      </a>

      <button
        type="button"
        class="site-header__mobile-btn"
        aria-label="Toggle Menu"
        aria-expanded="false"
        aria-controls="SiteHeaderNav-{{ section.id }}"
        onclick="
          const nav = document.getElementById('SiteHeaderNav-{{ section.id }}');
          const expanded = this.getAttribute('aria-expanded') === 'true';
          this.setAttribute('aria-expanded', !expanded);
          nav.classList.toggle('is-open');
        "
      >
        ☰
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}