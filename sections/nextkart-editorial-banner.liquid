{{ 'nextkart-homepage.css' | asset_url | stylesheet_tag }}{% assign image = section.settings.image %}<section class="page-width" style="padding-top:32px;padding-bottom:32px"><div class="nextkart-editorial" style="--nk-height:{{ section.settings.min_height }}px;--nk-radius:{{ section.settings.corner_radius }}px;--nk-accent:{{ section.settings.accent_color }}">{% if section.settings.image_position == 'left' %}<div class="nextkart-editorial__media">{% if image != blank %}{{ image | image_url: width: 1800 | image_tag: widths: '550, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: image.alt }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'nextkart-editorial__placeholder' }}{% endif %}</div>{% endif %}<div class="nextkart-editorial__content color-{{ section.settings.color_scheme }} gradient">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><p class="nextkart-eyebrow">{{ block.settings.eyebrow | escape }}</p><h2 class="nextkart-editorial__title">{{ block.settings.heading | escape }}</h2><div class="nextkart-editorial__text rte">{{ block.settings.text }}</div>{% if block.settings.button_label != blank and block.settings.link != blank %}<a class="nextkart-editorial__button" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div>{% endfor %}</div>{% if section.settings.image_position == 'right' %}<div class="nextkart-editorial__media">{% if image != blank %}{{ image | image_url: width: 1800 | image_tag: widths: '550, 750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: image.alt }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'nextkart-editorial__placeholder' }}{% endif %}</div>{% endif %}</div></section>
{% schema %}
{"name":"NextKart editorial banner","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_position","label":"Image position","default":"right","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},{"type":"range","id":"min_height","min":300,"max":700,"step":20,"unit":"px","label":"Minimum height","default":480},{"type":"range","id":"corner_radius","min":0,"max":36,"step":2,"unit":"px","label":"Corner radius","default":20},{"type":"color","id":"accent_color","label":"Accent color","default":"#6C2BFF"},{"type":"color_scheme","id":"color_scheme","label":"Content color scheme","default":"background-2"}],"blocks":[{"type":"content","name":"Content","limit":1,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EVERYDAY EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Made for your moments."},{"type":"richtext","id":"text","label":"Text","default":"<p>Easy-to-wear styles, thoughtful details and fresh favourites for every day.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"link","label":"Button link"}]}],"presets":[{"name":"NextKart editorial banner","blocks":[{"type":"content"}]}]}
{% endschema %}