{{ 'nextkart-homepage.css' | asset_url | stylesheet_tag }}<section class="color-{{ section.settings.color_scheme }} gradient" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="page-width"><div class="nextkart-promo__header"><p class="nextkart-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="nextkart-promo__title">{{ section.settings.title | escape }}</h2></div><div class="nextkart-promo__grid">{% for block in section.blocks %}<article class="nextkart-promo__card nextkart-promo__card--{{ block.settings.tone }}" {{ block.shopify_attributes }}><p class="nextkart-eyebrow">{{ block.settings.eyebrow | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.button_label != blank and block.settings.link != blank %}<a class="nextkart-promo__link" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</article>{% endfor %}</div></div></section>
{% schema %}
{"name":"NextKart promo grid","tag":"section","class":"section","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED TO INSPIRE"},{"type":"text","id":"title","label":"Heading","default":"Your next favourite starts here."},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"background-1"},{"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"Top padding","default":48},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Bottom padding","default":48}],"blocks":[{"type":"card","name":"Promo card","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"JUST DROPPED"},{"type":"text","id":"title","label":"Title","default":"New arrivals"},{"type":"text","id":"text","label":"Description","default":"Meet the latest additions to your rotation."},{"type":"text","id":"button_label","label":"Link label","default":"Shop now"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"tone","label":"Card tone","default":"violet","options":[{"value":"violet","label":"Violet"},{"value":"sand","label":"Sand"},{"value":"blue","label":"Blue"}]}]}],"presets":[{"name":"NextKart promo grid","blocks":[{"type":"card"},{"type":"card","settings":{"eyebrow":"THE DAILY LINE-UP","title":"Everyday essentials","text":"Easy staples to reach for on repeat.","button_label":"Explore essentials","tone":"sand"}},{"type":"card","settings":{"eyebrow":"CURATED FOR YOU","title":"The style edit","text":"Fresh ideas for your next favourite look.","button_label":"Discover the edit","tone":"blue"}}]}]}
{% endschema %}