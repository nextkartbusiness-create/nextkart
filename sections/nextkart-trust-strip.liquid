{{ 'nextkart-homepage.css' | asset_url | stylesheet_tag }}<section class="color-{{ section.settings.color_scheme }} gradient" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="page-width"><div class="nextkart-trust" role="list" aria-label="Store benefits">{% for block in section.blocks %}<div class="nextkart-trust__item" role="listitem" {{ block.shopify_attributes }}><span class="nextkart-trust__icon" aria-hidden="true">{% case block.settings.icon %}{% when 'lock' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3"/></svg>{% when 'truck' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>{% when 'chat' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-9 8.5 9.6 9.6 0 0 1-4-.9L3 21l1.7-4.2A8 8 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5Z"/></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.8 8.8c0 5.2-8.8 11-8.8 11s-8.8-5.8-8.8-11a4.8 4.8 0 0 1 8.8-2.6 4.8 4.8 0 0 1 8.8 2.6Z"/></svg>{% endcase %}</span><div><p class="nextkart-trust__title">{{ block.settings.title | escape }}</p><p class="nextkart-trust__text">{{ block.settings.text | escape }}</p></div></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"NextKart trust strip","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"background-2"},{"type":"range","id":"padding_top","min":0,"max":64,"step":4,"unit":"px","label":"Top padding","default":24},{"type":"range","id":"padding_bottom","min":0,"max":64,"step":4,"unit":"px","label":"Bottom padding","default":24}],"blocks":[{"type":"item","name":"Benefit","settings":[{"type":"select","id":"icon","label":"Icon","default":"lock","options":[{"value":"lock","label":"Secure payment"},{"value":"truck","label":"Fast dispatch"},{"value":"chat","label":"Support"},{"value":"heart","label":"Customer care"}]},{"type":"text","id":"title","label":"Title","default":"Secure payments"},{"type":"text","id":"text","label":"Description","default":"Safe and trusted checkout"}]}],"presets":[{"name":"NextKart trust strip","blocks":[{"type":"item"},{"type":"item","settings":{"icon":"truck","title":"Fast dispatch","text":"Carefully packed orders"}},{"type":"item","settings":{"icon":"chat","title":"Friendly support","text":"We are here to help"}},{"type":"item","settings":{"icon":"heart","title":"Easy assistance","text":"Support when you need it"}}]}]}
{% endschema %}