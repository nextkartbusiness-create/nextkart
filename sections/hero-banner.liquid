        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.hero_banner.blocks.slide.settings.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_banner.presets.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
