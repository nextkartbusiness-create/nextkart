{%- liquid
  assign tile_count = section.blocks.size
-%}

<section
  id="NextkartSixTiles-{{ section.id }}"
  class="nextkart-six-tiles color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class="nextkart-six-tiles__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nextkart-six-tiles__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="nextkart-six-tiles__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="nextkart-six-tiles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_link = block.settings.link
          assign tile_image = block.settings.image
          assign tile_title = block.settings.title
          assign tile_subtitle = block.settings.subtitle
        -%}
        <article class="nextkart-six-tiles__item" {{ block.shopify_attributes }}>
          {%- if tile_link != blank -%}
            <a class="nextkart-six-tiles__card" href="{{ tile_link }}" aria-label="{{ tile_title | default: 'Explore collection' | escape }}">
          {%- else -%}
            <div class="nextkart-six-tiles__card">
          {%- endif -%}
              <div class="nextkart-six-tiles__media">
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '320, 480, 640, 800, 1000',
                      sizes: '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      class: 'nextkart-six-tiles__image',
                      alt: tile_image.alt
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'nextkart-six-tiles__image placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="nextkart-six-tiles__overlay"></div>
              <div class="nextkart-six-tiles__content">
                {%- if tile_subtitle != blank -%}
                  <p class="nextkart-six-tiles__subtitle">{{ tile_subtitle | escape }}</p>
                {%- endif -%}
                {%- if tile_title != blank -%}
                  <h3 class="nextkart-six-tiles__title">{{ tile_title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="nextkart-six-tiles__button">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></span>
                {%- endif -%}
              </div>
          {%- if tile_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #NextkartSixTiles-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__header {
    text-align: {{ section.settings.text_alignment }};
    margin: 0 auto 2.4rem;
    max-width: 760px;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__eyebrow {
    margin: 0 0 .7rem;
    color: {{ section.settings.accent_color }};
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__description {
    margin-top: .8rem;
    opacity: .78;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__item {
    min-width: 0;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__card {
    position: relative;
    display: block;
    min-height: {{ section.settings.card_height }}px;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    background: #242424;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__media,
  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__overlay {
    position: absolute;
    inset: 0;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .55s ease;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__overlay {
    z-index: 1;
    background: linear-gradient(180deg, rgba(0,0,0,0) 20%, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__content {
    position: absolute;
    z-index: 2;
    left: 2rem;
    right: 2rem;
    bottom: 2rem;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__subtitle {
    margin: 0 0 .4rem;
    font-size: 1.1rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .9;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__title {
    color: inherit;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 2.5vw, 3rem);
    line-height: 1.1;
  }

  #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__button {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    padding: .9rem 1.4rem;
    border: 1px solid rgba(255,255,255,.75);
    border-radius: 999px;
    font-size: 1.2rem;
    font-weight: 700;
    transition: background .2s ease, color .2s ease;
  }

  @media (hover: hover) {
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__card:hover .nextkart-six-tiles__image {
      transform: scale(1.06);
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__card:hover .nextkart-six-tiles__button {
      background: #fff;
      color: #111;
    }
  }

  @media screen and (max-width: 749px) {
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: max(8px, {{ section.settings.grid_gap | divided_by: 2 }}px);
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__card {
      min-height: {{ section.settings.mobile_card_height }}px;
      border-radius: max(10px, {{ section.settings.corner_radius | divided_by: 1.5 }}px);
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__content {
      left: 1.2rem;
      right: 1.2rem;
      bottom: 1.2rem;
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__title {
      font-size: clamp(1.5rem, 4vw, 2rem);
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__subtitle {
      font-size: .9rem;
    }
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__button {
      padding: .7rem 1rem;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__image,
    #NextkartSixTiles-{{ section.id }} .nextkart-six-tiles__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nextkart - 6 image tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE NEXTKART EDIT" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Find your style" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Explore the latest looks for every part of your wardrobe.</p>" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#6C2BFF" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "range", "id": "card_height", "min": 220, "max": 520, "step": 20, "unit": "px", "label": "Desktop tile height", "default": 340 },
    { "type": "range", "id": "mobile_card_height", "min": 160, "max": 360, "step": 10, "unit": "px", "label": "Mobile tile height", "default": 220 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 36, "step": 2, "unit": "px", "label": "Corner radius", "default": 18 },
    { "type": "range", "id": "grid_gap", "min": 8, "max": 32, "step": 2, "unit": "px", "label": "Grid gap", "default": 16 },
    { "type": "range", "id": "overlay_opacity", "min": 10, "max": 85, "step": 5, "unit": "%", "label": "Image overlay", "default": 45 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 44 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "subtitle", "label": "Small heading", "default": "DISCOVER THE EDIT" },
        { "type": "text", "id": "title", "label": "Title", "default": "New arrivals" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nextkart - 6 image tiles",
      "blocks": [
        { "type": "tile", "settings": { "subtitle": "FOR HIM", "title": "Men", "button_label": "Shop men" } },
        { "type": "tile", "settings": { "subtitle": "FOR HER", "title": "Women", "button_label": "Shop women" } },
        { "type": "tile", "settings": { "subtitle": "LITTLE STYLES", "title": "Kids", "button_label": "Shop kids" } },
        { "type": "tile", "settings": { "subtitle": "JUST LANDED", "title": "New arrivals", "button_label": "Explore new" } },
        { "type": "tile", "settings": { "subtitle": "COMPLETE THE LOOK", "title": "Accessories", "button_label": "Discover" } },
        { "type": "tile", "settings": { "subtitle": "MORE TO LOVE", "title": "Best sellers", "button_label": "Shop popular" } }
      ]
    }
  ]
}
{% endschema %}
